{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/interactive-project/content-node/blob/main/schemas/content-node.v1.schema.json",
  "title": "Portable ContentNode v1",
  "$ref": "#/$defs/content",
  "$defs": {
    "text": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "text"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "accessibility": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/accessibility"
        },
        "value": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/localizedText"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "value"
      ],
      "additionalProperties": false
    },
    "markdown": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "markdown"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "accessibility": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/accessibility"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "plainText": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/localizedText"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "source",
        "plainText"
      ],
      "additionalProperties": false
    },
    "math": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "math"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "accessibility": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/accessibility"
        },
        "format": {
          "const": "tex"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "plainText": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/localizedText"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "format",
        "source",
        "plainText"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "image"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "accessibility": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/accessibility"
        },
        "asset": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/assetRef"
        },
        "alt": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/localizedText"
        },
        "caption": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/localizedText"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "asset",
        "alt"
      ],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "code"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "accessibility": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/accessibility"
        },
        "source": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100000
        },
        "programmingLanguage": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9+.-]*$"
        },
        "caption": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/localizedText"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "source",
        "programmingLanguage"
      ],
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        },
        "text": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/localizedText"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "audio"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "accessibility": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/accessibility"
        },
        "asset": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/assetRef"
        },
        "transcript": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/localizedText"
        },
        "caption": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/localizedText"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "asset",
        "transcript"
      ],
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "video"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "accessibility": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/accessibility"
        },
        "asset": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/assetRef"
        },
        "transcript": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/localizedText"
        },
        "captions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "caption": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/localizedText"
        },
        "poster": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/assetRef"
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "asset",
        "transcript",
        "captions"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "group"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "accessibility": {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/accessibility"
        },
        "layout": {
          "enum": [
            "inline",
            "block"
          ]
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/content"
          }
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "children"
      ],
      "additionalProperties": false
    },
    "content": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/markdown"
        },
        {
          "$ref": "#/$defs/math"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/code"
        },
        {
          "$ref": "#/$defs/audio"
        },
        {
          "$ref": "#/$defs/video"
        },
        {
          "$ref": "#/$defs/group"
        },
        {
          "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/shared-content.v1.schema.json#/$defs/contentRef"
        }
      ]
    }
  }
}
